generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Meeting {
  id                           Int                           @id @default(autoincrement())
  date                         String // 시작일 "2026-03-21"
  endDate                      String? // 1박 이상이면 마지막 날. 당일 모임은 null
  startTime                    String // 첫날 시작 "07:00"
  endTime                      String // 마지막 날 종료 "22:00"
  location                     String
  description                  String?
  isOpen                       Boolean                       @default(true)
  regularFee                   Int // 정회원 참가비 (1박은 둘째 날 포함 총액)
  companionFee                 Int // 동반인 참가비
  lodgingFee                   Int                           @default(0) // 숙박 대상자 1인 숙박비
  billingPublishedAt           DateTime? // 청구 공개 시각. null 이면 공개 전
  billingPublishedByKakaoId    String?
  billingCorrectionReason      String?
  shopPaidAt                   DateTime? // 샵(장비+식음료) 지급
  shopPaidAmount               Int?
  settlementCompletedAt        DateTime?
  endedAt                      DateTime? // 운영진이 모임 종료를 누른 시각. 있으면 예정 종료 시각과 관계없이 끝난 모임이다.
  settlementCompletedByKakaoId String?
  settlementNote               String?
  shopUsageCheckedAt           DateTime? // 샵이 항목별 이용 수량을 확인한 시각 (이용 내역이 바뀌면 초기화)
  shopUsageCheckedByKakaoId    String?
  meetingType                  String                        @default("정기") // 정기 | 비정기
  createdByKakaoId             String? // null = admin, otherwise member's kakaoId
  participants                 Participant[]
  foodOrderItems               ParticipantFoodOrderItem[]
  foodOrders                   ParticipantFoodOrder[]
  surfUsages                   ParticipantSurfUsage[]
  chargeAdjustments            ParticipantChargeAdjustment[]
  settlementConfirmations      SettlementConfirmation[]
  billingSnapshot              MeetingBillingSnapshot?
  createdAt                    DateTime                      @default(now())
}

model Participant {
  id                Int                           @id @default(autoincrement())
  meetingId         Int
  meeting           Meeting                       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name              String
  kakaoId           String
  user              User?                         @relation(fields: [kakaoId], references: [kakaoId])
  kakaoNickname     String // 카카오 프로필 닉네임 (참고용)
  companionId       Int? // 동반인인 경우 Companion.id
  companion         Companion?                    @relation(fields: [companionId], references: [id])
  note              String?
  hasLesson         Boolean                       @default(false) // 강습 신청 (첫날)
  hasBus            Boolean                       @default(false) // 버스 이용
  hasRental         Boolean                       @default(false) // 장비 대여 필요 (첫날)
  hasDay2Rental     Boolean                       @default(false) // 1박: 둘째 날 장비 대여 필요
  usesClubLodging   Boolean                       @default(false) // 1박: 숙박비 청구 대상
  status            String                        @default("APPROVED") // APPROVED | WAITLISTED | CANCELLED
  absentAt          DateTime? // 운영진이 불참 처리한 시각. 참가비는 그대로 청구하고 실제 이용 확인에서만 뺀다
  waitlistPosition  Int?
  cancelledAt       DateTime?
  isPenalized       Boolean                       @default(false) // 취소 시 패널티 적용 여부
  usageSubmittedAt  DateTime? // 회원이 실제 이용을 직접 제출(수정)한 시각
  usageConfirmedAt  DateTime? // 운영진·샵이 실제 이용을 확정한 시각. 확정된 이용만 청구에 반영
  submittedAt       DateTime                      @default(now())
  foodOrderItems    ParticipantFoodOrderItem[]
  foodOrders        ParticipantFoodOrder[]
  surfUsages        ParticipantSurfUsage[]
  chargeAdjustments ParticipantChargeAdjustment[]

  @@unique([meetingId, kakaoId, companionId])
}

model ParticipantChargeAdjustment {
  id            Int         @id @default(autoincrement())
  meetingId     Int
  participantId Int
  label         String
  amount        Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  meeting       Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model FoodMenuItem {
  id              Int                        @id @default(autoincrement())
  categoryId      Int
  category        FoodMenuCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name            String
  price           Int
  optionGroupName String?
  isActive        Boolean                    @default(true)
  displayOrder    Int                        @default(0)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  orderItems      ParticipantFoodOrderItem[]
  optionChoices   FoodMenuOptionChoice[]
}

model FoodMenuCategory {
  id           Int            @id @default(autoincrement())
  name         String
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  menuItems    FoodMenuItem[]
}

model FoodMenuOptionChoice {
  id           Int                        @id @default(autoincrement())
  menuItemId   Int
  menuItem     FoodMenuItem               @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  label        String
  price        Int?
  displayOrder Int                        @default(0)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  orderItems   ParticipantFoodOrderItem[]

  @@index([menuItemId])
}

model ParticipantFoodOrder {
  id            Int                        @id @default(autoincrement())
  meetingId     Int
  participantId Int
  createdAt     DateTime                   @default(now())
  meeting       Meeting                    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant   Participant                @relation(fields: [participantId], references: [id], onDelete: Cascade)
  items         ParticipantFoodOrderItem[]

  @@index([meetingId, participantId])
}

model ParticipantFoodOrderItem {
  id                        Int                   @id @default(autoincrement())
  meetingId                 Int
  participantId             Int
  foodOrderId               Int
  menuItemId                Int?
  menuOptionChoiceId        Int?
  menuNameSnapshot          String
  optionGroupNameSnapshot   String?
  optionChoiceLabelSnapshot String?
  unitPriceSnapshot         Int
  quantity                  Int
  preparingQuantity         Int                   @default(0)
  servedQuantity            Int                   @default(0)
  cancelledAt               DateTime?
  cancelledReasonCode       String?
  cancelledReasonText       String?
  cancelledByKakaoId        String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  meeting                   Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant               Participant           @relation(fields: [participantId], references: [id], onDelete: Cascade)
  menuItem                  FoodMenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  menuOptionChoice          FoodMenuOptionChoice? @relation(fields: [menuOptionChoiceId], references: [id], onDelete: SetNull)
  foodOrder                 ParticipantFoodOrder  @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)

  @@index([meetingId, participantId])
  @@index([foodOrderId])
  @@index([menuOptionChoiceId])
  @@index([cancelledAt])
}

model UserNotification {
  id               Int       @id @default(autoincrement())
  recipientKakaoId String
  type             String
  meetingId        Int?
  participantId    Int?
  foodOrderItemId  Int?
  title            String
  body             String
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([recipientKakaoId, readAt, createdAt])
  @@index([meetingId])
  @@index([participantId])
  @@index([foodOrderItemId])
}

// 샵 이용 항목표(모든 모임 공통). 기록할 때 가격을 함께 저장하므로 바꿔도 지난 기록은 그대로다.
model SurfUsageItem {
  id           Int                    @id @default(autoincrement())
  name         String
  description  String?
  serviceType  String // LESSON_PACKAGE | EQUIPMENT_RENTAL | WETSUIT_ONLY | SHOWER | CUSTOM
  shopPrice    Int
  regularPrice Int? // 정회원 가격. 0 = 동호회 지원, 금액 = 고정, null = 샵 가격. 동반인은 항상 샵 가격
  isActive     Boolean                @default(true)
  displayOrder Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  usages       ParticipantSurfUsage[]
}

model ParticipantSurfUsage {
  id                    Int           @id @default(autoincrement())
  meetingId             Int
  participantId         Int
  day                   Int           @default(1) // 1박의 몇째 날
  usageItemId           Int
  quantity              Int
  usageItemNameSnapshot String
  serviceTypeSnapshot   String
  shopUnitPriceSnapshot Int
  regularPriceSnapshot  Int? // 기록 시점의 정회원 가격 (null = 샵 가격)
  source                String        @default("participant") // participant | shop | signup
  submittedByKakaoId    String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  meeting               Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant           Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  usageItem             SurfUsageItem @relation(fields: [usageItemId], references: [id], onDelete: Restrict)

  @@index([meetingId, participantId])
  @@index([usageItemId])
}

model SettlementConfirmation {
  id                Int          @id @default(autoincrement())
  meetingId         Int
  recipientKakaoId  String
  confirmedAt       DateTime     @default(now())
  verifiedAt        DateTime?
  verifiedByKakaoId String?
  depositId         Int? // 은행 입금으로 확인했으면 그 입금. 수동 확인은 null
  meeting           Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  deposit           BankDeposit? @relation(fields: [depositId], references: [id], onDelete: SetNull)

  @@unique([meetingId, recipientKakaoId])
  @@index([depositId])
}

model MeetingBillingSnapshot {
  id                 Int      @id @default(autoincrement())
  meetingId          Int      @unique
  revision           Int      @default(1)
  accountBankName    String?
  accountNumber      String?
  accountHolder      String?
  memberChargeTotal  Int
  shopPayableTotal   Int
  foodPayableTotal   Int
  clubSupportTotal   Int
  data               Json
  publishedAt        DateTime @default(now())
  publishedByKakaoId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  meeting            Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                    Int           @id @default(autoincrement())
  kakaoId               String        @unique
  name                  String? // 카카오 또는 유저가 정한 이름
  profileImage          String?
  customProfileImageUrl String?
  phoneNumber           String?
  role                  String        @default("MEMBER") // ADMIN, SHOP_OWNER, MEMBER, BANNED
  memberType            String        @default("REGULAR") // REGULAR | COMPANION
  penaltyCount          Int           @default(0) // 누적 패널티 횟수
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  participants          Participant[]
  companions            Companion[] // 내가 등록한 동반인 목록
}

model Companion {
  id            Int           @id @default(autoincrement())
  name          String
  ownerKakaoId  String // 등록한 정회원의 kakaoId
  owner         User          @relation(fields: [ownerKakaoId], references: [kakaoId])
  linkedKakaoId String? // 카카오 로그인으로 연동된 동반인의 kakaoId
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  participants  Participant[]
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model DeletedKakaoId {
  id        Int      @id @default(autoincrement())
  kakaoId   String   @unique
  deletedAt DateTime @default(now())
}

// 정산 계좌 입금 알림(안드로이드 알림 전달)으로 들어온 입금 기록
model BankDeposit {
  id               Int                      @id @default(autoincrement())
  rawTitle         String?
  rawText          String
  depositorName    String?
  amount           Int?
  depositedAt      DateTime
  receivedAt       DateTime                 @default(now())
  status           String                   @default("UNMATCHED") // UNMATCHED(자동 대조 대기) | REVIEW(운영진 확인 필요) | MATCHED | IGNORED | UNPARSED
  matchedByKakaoId String? // "bank-auto" = 자동 대조
  matchedAt        DateTime?
  sourceDeviceId   Int? // 처음 전달한 폰
  // 이 입금으로 확인한 청구 수. 청구 재공개 등으로 확인 기록이 지워져 연결이 이보다 적어지면 다시 대조한다.
  matchedCount     Int                      @default(0)
  confirmations    SettlementConfirmation[]

  @@index([status, depositedAt])
  @@index([rawText, depositedAt])
}

// 은행 입금자명 → 회원 연결 (가족 명의, 별명 등)
model DepositorAlias {
  id            Int      @id @default(autoincrement())
  depositorName String   @unique
  kakaoId       String
  createdAt     DateTime @default(now())
}

// 입금 알림을 전달하는 운영진 폰(안드로이드). 폰마다 토큰을 따로 발급해 개별로 끊을 수 있다.
model BankWebhookDevice {
  id         Int       @id @default(autoincrement())
  label      String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?
}
